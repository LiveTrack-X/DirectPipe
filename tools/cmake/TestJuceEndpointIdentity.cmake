# The juceaide bootstrap is also an input to the guarded extension. An unknown
# third file must be detected before either audio-device file is modified.
make_fixture(unknown_bootstrap)
list(GET files 2 bootstrap)
file(APPEND "${TEST_WORK_DIR}/unknown_bootstrap/${bootstrap}" "\n# unexpected bootstrap change\n")
file(READ "${TEST_WORK_DIR}/unknown_bootstrap/${bootstrap}" bootstrap_unknown)
string(SHA256 bootstrap_unknown_hash "${bootstrap_unknown}")
run_patch(unknown_bootstrap FALSE)
foreach(index RANGE 0 1)
    list(GET original_hashes ${index} expected)
    check_hash(unknown_bootstrap ${index} "${expected}")
endforeach()
check_hash(unknown_bootstrap 2 "${bootstrap_unknown_hash}")

# Windows checkouts may use CRLF; all three guards use normalized source bytes.
make_fixture(crlf)
foreach(index RANGE 0 2)
    list(GET files ${index} relative)
    file(READ "${TEST_WORK_DIR}/crlf/${relative}" content)
    string(REPLACE "\n" "\r\n" content "${content}")
    file(WRITE "${TEST_WORK_DIR}/crlf/${relative}" "${content}")
endforeach()
run_patch(crlf TRUE)
foreach(index RANGE 0 2)
    list(GET patched_hashes ${index} expected)
    check_hash(crlf ${index} "${expected}")
endforeach()
# Execute the actual inserted CMake block without configuring/building JUCE.
file(READ "${TEST_WORK_DIR}/clean/${bootstrap}" bootstrap_patched)
string(FIND "${bootstrap_patched}" "    set(PASSTHROUGH_ARGS \"\")" block_start)
string(FIND "${bootstrap_patched}" "    # Looks like we're bootstrapping, reinvoke CMake" block_end)
if(block_start LESS 0 OR block_end LESS block_start)
    message(FATAL_ERROR "Patched juceaide argument block is missing")
endif()
math(EXPR block_length "${block_end} - ${block_start}")
string(SUBSTRING "${bootstrap_patched}" ${block_start} ${block_length} bootstrap_arguments)
set(CMAKE_CROSSCOMPILING FALSE)
foreach(target IN ITEMS 10.15 12.0)
    set(CMAKE_OSX_DEPLOYMENT_TARGET "${target}")
    cmake_language(EVAL CODE "${bootstrap_arguments}")
    if(NOT PASSTHROUGH_ARGS STREQUAL "-DCMAKE_OSX_DEPLOYMENT_TARGET=${target}")
        message(FATAL_ERROR "juceaide did not retain selected macOS deployment target")
    endif()
endforeach()
set(CMAKE_CROSSCOMPILING TRUE)
cmake_language(EVAL CODE "${bootstrap_arguments}")
if(PASSTHROUGH_ARGS)
    message(FATAL_ERROR "Cross-compilation target leaked into the host helper")
endif()
set(CMAKE_CROSSCOMPILING FALSE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "")
cmake_language(EVAL CODE "${bootstrap_arguments}")
if(PASSTHROUGH_ARGS)
    message(FATAL_ERROR "An absent macOS target was invented")
endif()
message(STATUS "JUCE extension guard: clean, idempotent, unknown audio/bootstrap no-write, mixed, CRLF and target passthrough passed")
